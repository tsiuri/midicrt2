[Unit]
Description=midicrt2 web dashboard (control on, LAN-open, no auth)
After=midicrtd.service
Wants=midicrtd.service

[Service]
User=billie
# No Group= override (unlike midicrtd.service's Group=audio, needed for
# PortAudio device access, or midicrt-fb.service's Group=video +
# SupplementaryGroups=input, needed for /dev/fb0 + evdev): this unit is a
# pure protocol CLIENT of midicrtd's existing Unix socket
# (/run/midicrt/ctl.sock, created by midicrtd's own RuntimeDirectory=midicrt
# as billie:audio) and never touches audio/video/input devices itself.
# Connecting to that socket only requires owner-level access on the socket
# file plus traversal on /run/midicrt, both already satisfied by matching
# midicrtd's own User=billie -- no supplementary group needed.
ExecStart=/home/billie/midicrt2-venv/bin/midicrt-web --host 0.0.0.0 --port 8766
# Deployment decision (Phase 9 Task 4, user ruling: "web control ON, no
# auth" -- supersedes the Phase 6 parity-era read-only default documented
# in docs/phase6-notes.md item 7 / docs/phase6-web.md §3): bind
# 0.0.0.0:8766 (LAN-reachable, no auth) WITH control on -- no flag needed
# here at all, since control is now midicrt-web's own default (app.py's
# CLI inverted from an opt-IN `--allow-control` to an opt-OUT
# `--read-only`; pass `--read-only` here instead if this box's posture
# ever needs to revert to observer-only). The Pi has no firewall and this
# is a single-purpose LAN appliance already trusted with unauthenticated
# control via `midicrt`/`midicrt-fb`/the TUI on the box itself and v1's
# own long-running :8765 observer -- this unit now matches that same
# "anyone on the LAN can drive it" posture explicitly, rather than being
# the one web-reachable surface that couldn't.
#
# Installed 2026-08-10, NOT enabled and NOT started (standing rule: the
# user starts it when wanted) -- `systemctl is-enabled midicrt-web`
# reports `disabled`, `is-active` reports `inactive`.
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

[Unit]
Description=midicrt2 engine daemon
After=network.target sound.target
# Phase-3 task 8 review fix: defense-in-depth ordering ONLY -- correctness
# must NOT depend on this (systemd does not guarantee user@<uid>.service is
# actually done initializing PipeWire just because it's been "started" by
# the time this unit's After= is satisfied, and a real boot can still race
# it either way). The real fix is analyzers/spectrum.py's AudioCapture
# retry/health-check supervisor, which recovers on its own on a 5s cooldown
# regardless of ordering. This line just makes the common case faster.
After=user@1000.service

[Service]
User=billie
Group=audio
RuntimeDirectory=midicrt
# Phase 5 Task 1 (event-sourced capture, docs/phase5-notes.md): creates
# /var/lib/midicrt (owned by this unit's own User=/Group=, same convention
# as RuntimeDirectory=midicrt above for /run/midicrt) before the daemon
# starts -- engine/capture.py::CaptureSink writes session .jsonl files +
# index.json under /var/lib/midicrt/sessions. Unlike RuntimeDirectory,
# StateDirectory persists across reboots (systemd never clears it), which
# is the whole point -- captured sessions must survive a restart.
StateDirectory=midicrt
ExecStart=/home/billie/midicrt2-venv/bin/midicrtd
Restart=on-failure
RestartSec=2
Environment=PYTHONUNBUFFERED=1
# Phase-3 task 8 (analyzers/spectrum.py): this is a SYSTEM service (not a
# user session), so it does not inherit billie's login-session environment
# -- without XDG_RUNTIME_DIR, sounddevice/PortAudio's default-device query
# fails outright ("Error querying device -1", verified against this exact
# unit/user), because the ALSA "default" PCM's pipewire/pulse routing
# depends on finding the user's PipeWire socket under /run/user/<uid>.
#
# Deliberately HARDCODED, not "/run/user/%U" -- verified against
# `man systemd.unit` (systemd 257.8) and empirically on this box: %U/%u/%h
# resolve to the SERVICE MANAGER instance's own user (root/"0"/"/root" for
# ANY system-scope unit, unconditionally), never to this unit's own
# `User=` setting. Deploying `%U` here actually broke capture (confirmed:
# `systemctl show midicrtd -p Environment` read back
# "XDG_RUNTIME_DIR=/run/user/0", and the daemon logged the same "Error
# querying device -1" failure this whole Environment= line exists to fix)
# before being caught and reverted. There is no systemd specifier for "the
# UID of the user configured via this unit's own User=" -- billie is
# already a fixed, hardcoded uid 1000 throughout this unit (User=billie,
# RuntimeDirectory=midicrt under /run), so hardcoding the matching runtime
# dir here is consistent with that, not a new assumption, and is the
# correct fix, not a workaround.
Environment=XDG_RUNTIME_DIR=/run/user/1000

[Install]
WantedBy=multi-user.target
